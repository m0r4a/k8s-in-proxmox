proxmox_endpoint             = "https://192.168.1.2:8006/"
proxmox_api_token            = "terraform-prov@pve!mytoken=replace-with-your-token-secret"
proxmox_insecure             = true
proxmox_ssh_user             = "tfprov"
proxmox_ssh_private_key_path = "~/.ssh/id_ed25519"

vm_user              = "mora"
vm_password          = "change-me"
ssh_public_key       = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"
network_gateway      = "10.0.0.253"

# One entry per Proxmox node the VMs run on. With more than one, every VM in
# main.tf must set proxmox_node.
proxmox_nodes = {
  server01 = { template_vm_id = 9001, network_bridge = "vmbr1" }
}
