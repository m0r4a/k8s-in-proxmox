# Templates: either create one per Proxmox node with the vm_template module or
# use existing ones (e.g. from proxmox_setup.sh). Uncomment one of the options
# below. var.proxmox_nodes (terraform.tfvars) lists the Proxmox nodes and the
# template VM ID for each; IDs must be unique across the Proxmox cluster.

# Option 1: create the templates with the vm_template module.
module "vm_template" {
  for_each = var.proxmox_nodes
  source   = "../modules/vm_template"

  proxmox_node    = coalesce(each.value.proxmox_node_name, each.key)
  template_vm_id  = each.value.template_vm_id
  network_bridge  = each.value.network_bridge
  vm_user         = var.vm_user
  ssh_public_keys = [trimspace(file(pathexpand(var.ssh_public_key)))]
}

# Option 1a: create the templates from an image already on each Proxmox node.
# module "vm_template" {
#   for_each = var.proxmox_nodes
#   source   = "../modules/vm_template"
#
#   proxmox_node    = coalesce(each.value.proxmox_node_name, each.key)
#   template_vm_id  = each.value.template_vm_id
#   network_bridge  = each.value.network_bridge
#   vm_user         = var.vm_user
#   image_url       = null
#   image_file_id   = "local:import/rocky10-cloudinit.qcow2"
#   ssh_public_keys = [trimspace(file(pathexpand(var.ssh_public_key)))]
# }

# Option 2: use existing templates (e.g. created by proxmox_setup.sh). Skip
# the vm_template module and drop the `depends_on` at the end of k8s_cluster.

module "k8s_cluster" {
  source = "../modules/k8s_cluster"

  distribution         = "k3s" # or "kubeadm"
  vm_user              = var.vm_user
  vm_password          = var.vm_password
  ssh_public_key       = var.ssh_public_key
  ssh_private_key_path = var.ssh_private_key_path
  network_gateway      = var.network_gateway

  proxmox_nodes = var.proxmox_nodes

  # Writes ansible/inventory.d/10-cluster.ini. Storage nodes are provisioned
  # separately by the storage root (see ../storage) and contribute their own
  # inventory.d fragment.
  ansible = {
    enabled = true
    path    = "../../ansible"
  }

  nodes = {
    control-plane = {
      vmid   = 201
      role   = "control-plane"
      ip     = "10.0.0.10"
      memory = 4096
      cores  = 2
    }
    worker1 = {
      vmid   = 202
      role   = "worker"
      ip     = "10.0.0.11"
      memory = 4096
      cores  = 2
    }
    worker2 = {
      vmid   = 203
      role   = "worker"
      ip     = "10.0.0.12"
      memory = 4096
      cores  = 2
      # proxmox_node = "server02"  # required once proxmox_nodes has more than one entry
    }
  }

  # The VMs clone the templates, so create those first.
  depends_on = [module.vm_template]
}
