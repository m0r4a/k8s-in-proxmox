# Templates: either create one per Proxmox node with the vm_template module or
# use existing ones (e.g. from proxmox_setup.sh). var.proxmox_nodes
# (terraform.tfvars) lists the Proxmox nodes and the template VM ID for each;
# IDs must be unique across the Proxmox cluster.

# Option 1: create the templates with the vm_template module.
module "vm_template" {
  source = "../modules/vm_template"

  proxmox_nodes  = var.proxmox_nodes
  vm_user        = var.vm_user
  ssh_public_key = var.ssh_public_key

  # Option 1a: import an image already on each Proxmox node instead of
  # downloading it.
  # image_url     = null
  # image_file_id = "local:import/rocky10-cloudinit.qcow2"
}

# Option 2: use existing templates (e.g. created by proxmox_setup.sh). Remove
# the vm_template module and set `proxmox_nodes = var.proxmox_nodes` below.

module "k8s_cluster" {
  source = "../modules/k8s_cluster"

  distribution         = "k3s" # or "kubeadm"
  vm_user              = var.vm_user
  vm_password          = var.vm_password
  ssh_public_key       = var.ssh_public_key
  ssh_private_key_path = var.ssh_private_key_path
  network_gateway      = var.network_gateway

  # The same nodes as the templates, available once those exist.
  proxmox_nodes = module.vm_template.proxmox_nodes

  # Writes ansible/inventory.d/10-cluster.ini. Storage nodes are provisioned
  # separately by the storage root (see ../storage) and contribute their own
  # inventory.d fragment.
  ansible = {
    enabled = true
    path    = "../../ansible"
  }

  nodes = {
    control-plane = {
      vmid   = 201
      role   = "control-plane"
      ip     = "10.0.0.10"
      memory = 4096
      cores  = 2
    }
    worker1 = {
      vmid   = 202
      role   = "worker"
      ip     = "10.0.0.11"
      memory = 4096
      cores  = 2
    }
    worker2 = {
      vmid   = 203
      role   = "worker"
      ip     = "10.0.0.12"
      memory = 4096
      cores  = 2
      # proxmox_node = "server02"  # required once proxmox_nodes has more than one entry
    }
  }
}
