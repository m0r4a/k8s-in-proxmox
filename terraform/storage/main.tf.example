# Storage root: long-lived SeaweedFS storage VMs, in their own Terraform state.
#
# This root is independent from terraform/cluster. A `terraform destroy` of the
# cluster root never touches storage. Apply this once and leave it running.
#
# Copy to main.tf and edit the node definitions:
#   cp main.tf.example main.tf
#
# The templates are NOT created here. Create them first with the cluster root's
# vm_template module (or proxmox_setup.sh --create-template) and list them in
# proxmox_nodes (terraform.tfvars).

module "storage_node" {
  source = "../modules/storage_node"

  proxmox_nodes        = var.proxmox_nodes
  vm_user              = var.vm_user
  vm_password          = var.vm_password
  ssh_public_key       = var.ssh_public_key
  ssh_private_key_path = var.ssh_private_key_path
  network_gateway      = var.network_gateway

  # Writes ansible/inventory.d/20-storage.ini, read alongside the cluster
  # fragment when Ansible runs against the inventory.d/ directory.
  ansible = {
    enabled = true
    path    = "../../ansible"
  }

  nodes = {
    storage1 = {
      vmid            = 301
      ip              = "10.0.0.20"
      memory          = 4096
      cores           = 2
      storage_disk_gb = 100
    }
  }
}
